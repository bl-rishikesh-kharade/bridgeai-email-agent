GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENVIRONMENT=development
APP_PORT=8000
LOG_LEVEL=INFO
# Optional: set LOG_FILE_PATH to override the OS-specific persistent log location.
OAUTH_CREDENTIALS_PATH=credentials/credentials.json
OAUTH_TOKEN_PATH=token.json
REQUEST_TIMEOUT=30
GEMINI_TIMEOUT=60

# For Cloud / Vercel Web Deployment (multi-user Google OAuth):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

